<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/kappastyle.css">
  <title>アバターを選択</title>
</head>
<body>
  <div class="box">
    <h1><%= @table_id %>番テーブル</h1>
    <p style="text-align: center;">誰が注文しますか？</p>
    
    <% @avatars.each do |id, data| %>
      <a href="/table/<%= @table_id %>/avatar/<%= id %>" class="avatar-card">
        <%= data[:icon] %> <%= data[:name] %>
      </a>
    <% end %>
    
    <br>
    <div style="text-align: center;">
      <a href="/">← テーブル一覧に戻る</a>
    </div>
  </div>
</body>
</html>
